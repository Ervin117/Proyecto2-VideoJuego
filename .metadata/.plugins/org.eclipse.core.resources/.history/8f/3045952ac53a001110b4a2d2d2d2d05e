		// Lógica seleccion de personaje jugador 2
		if (personaje_seleccionado_J2 == 0){
			if(control_J2.derecha){
				//Borrar cuadrado anterior
				Rect(162, 51, 74, 174, 0x0000); Rect(162, 52, 74, 174, 0x0000);
